if(NOT EXISTS "${EDITOR}")
 message(FATAL_ERROR "Editor executable is missing")
endif()
execute_process(COMMAND "${NM}" -C "${EDITOR}" OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Cannot inspect editor execution boundary")
endif()
if(symbols MATCHES "cmp::(SimulationEngine|DeviceVm|Cpu8085|AvrMachine|LogicVm|NativeLogic|Native8085)::|QJSEngine::|QV4::|qInitResources_cmp_avr")
 message(FATAL_ERROR "Simulation execution backend linked into the editor")
endif()
message(STATUS "Editor contains no simulation engine, VM, processor or native compiler implementations")
